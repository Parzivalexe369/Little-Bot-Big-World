; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Little Bot, Big World"
config/description="A cozy 3D exploration adventure about a tiny robot restoring an enormous, sleeping world."
config/version="1.0.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.07, 0.08, 0.1, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Events="*res://scripts/systems/events.gd"
Settings="*res://scripts/systems/settings.gd"
GameState="*res://scripts/systems/game_state.gd"
SaveSystem="*res://scripts/systems/save_system.gd"
Quests="*res://scripts/systems/quest_manager.gd"
Audio="*res://scripts/audio/audio_manager.gd"
SceneRouter="*res://scripts/systems/scene_router.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[gui]

theme/custom="res://resources/ui_theme.tres"

