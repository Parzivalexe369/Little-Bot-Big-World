[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"
3d_physics/layer_4="collectible"
3d_physics/layer_5="trigger"
3d_physics/layer_6="camera_only"
3d_physics/layer_7="beam"
3d_physics/layer_8="player_blocker"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.1, 1)
textures/default_filters/anisotropic_filtering_level=2
textures/vram_compression/import_etc2_astc=true
environment/ssao/quality=1
environment/glow/upscale_mode=1

[shader_globals]

restore_levels={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
scan_origin={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}
scan_time={
"type": "float",
"value": 100.0
}
wind_strength={
"type": "float",
"value": 1.0
}
player_position={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}
world_awake={
"type": "float",
"value": 0.0
}
foliage_near_fade={
"type": "float",
"value": 1.0
}
